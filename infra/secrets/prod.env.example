# prod 타겟 앱 env. 복사해서 secrets/prod.env 로 채운다 (커밋 금지).
#   cp secrets/prod.env.example secrets/prod.env
#
# ⚠️ 이 파일은 셸에서 `source` 되므로 `KEY=VALUE` 로 붙여 쓴다. `KEY = VALUE` (등호 주변 공백) 는 에러.
#    값에 공백/특수문자가 있으면 따옴표로 감싼다.
#
# NEXT_PUBLIC_* : 로컬 빌드 때 번들에 박제됨 (서버에서 바꿔도 안 바뀐다)
# 나머지        : 서버에서 next start 런타임에 읽힘 (.env.production 로 업로드됨)

# ===== 클라이언트 (빌드 타임 박제) =====
NEXT_PUBLIC_BACKEND_SERVER_BASE_URL=
NEXT_PUBLIC_FRONTEND_SERVER_BASE_URL=
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_IMAGE_S3_DOMAIN=
NEXT_PUBLIC_IMAGE_CLOUDFRONT_DOMAIN=
NEXT_PUBLIC_CDN_DOMAIN=
NEXT_PUBLIC_SENTRY_DSN=

# ===== 서버 런타임 =====
# 조회수 파일 경로. process.cwd() 기준 상대경로이고, deploy.sh 가 서버에 해당 디렉토리를 만든다.
VIEW_DATA_FILE_PATH=src/data/viewCount.json
VIEW_DATA_FLUSH_THRESHOLD=10

# ===== 빌드 전용 (서버로 업로드되지 않음) =====
# Sentry 소스맵 업로드용. deploy.sh 가 서버 env 에서 제외한다.
SENTRY_AUTH_TOKEN=
