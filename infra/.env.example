# 이 파일을 복사해서 .env 를 만들고 실제 값으로 채운다.
#   cp .env.example .env
# .env 는 절대 커밋하지 않는다 (.gitignore 에 등록됨)

# ===== 공통 =====
SSH_KEY=secrets/~.pem
APP_PORT=3000                    


# ===== dev 타겟 =====
DEV_SERVER_USER=ubuntu
DEV_SERVER_HOST=                      # dev 서버 IP (Elastic IP 권장)
DEV_APP_ENV_FILE=secrets/dev.env      # 로컬의 dev용 앱 env (빌드 주입 + 서버 .env.local 로 업로드)
DEV_DOMAIN=
DEV_DOMAIN_ALIASES=
DEV_CERTBOT_EMAIL=

# ===== prod 타겟 =====
PROD_SERVER_USER=ubuntu
PROD_SERVER_HOST=                     # prod 서버 IP (Elastic IP 권장)
PROD_APP_ENV_FILE=secrets/prod.env    # 로컬의 prod용 앱 env (빌드 주입 + 서버 .env.production 로 업로드)
PROD_DOMAIN=
PROD_DOMAIN_ALIASES=
PROD_CERTBOT_EMAIL=

DEV_DOMAIN_ALIASES
